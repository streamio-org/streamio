TMDB_API_KEY=
# Optional. TheIntroDB (theintrodb.org) powers the watch page's "Skip
# Intro/Recap/Credits" button. Anonymous requests work fine without a key;
# set one only to prioritize your own submissions in their averaging.
THEINTRODB_API_KEY=

# ── App ──────────────────────────────────────────────────────
NODE_ENV=
# Public base URL this server is reachable on (used for OAuth redirect URIs,
# email links, and the Chromecast proxy base). Include any reverse-proxy path
# prefix, e.g. https://example.com/streamio. No trailing slash.
# For Chromecast it must be https and must answer /api/* without redirecting:
# the receiver page is served over https, so an http base is blocked as mixed
# content and casting quietly loses autoplay-next, re-resolve and remote logs.
APP_URL=
APP_NAME=Streamio

# Set to 1 to let /api/cast-proxy and video resolution fetch private or
# loopback addresses. Off by default, and it should stay off on anything
# publicly reachable: both take an absolute URL from the caller, so without
# the block they will fetch — and relay back — whatever the container can
# reach that the internet cannot (cloud metadata on 169.254.169.254, the db
# and redis containers, localhost). Turn on only to play a source on your
# own LAN.
ALLOW_PRIVATE_UPSTREAM=

# ── Email ────────────────────────────────────────────────────
# Transactional email: verification, password reset, welcome.
#
# Which transport to use: smtp | resend | log. Leave blank to auto-detect —
# SMTP_HOST set wins, else RESEND_API_KEY, else "log". Nothing configured is
# a supported setup: the server still boots and registration still works, the
# message (link and code included) is just printed to the server log instead
# of sent — recover it with `docker compose logs streamio`.
MAIL_TRANSPORT=

# Sender address. With SMTP this usually MUST equal SMTP_USER — Gmail and
# most providers rewrite or reject a From they don't own.
MAIL_FROM=

# SMTP — the option that works without a domain. Any ordinary mailbox will
# do and it delivers to arbitrary recipients. Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>
# The app password comes from myaccount.google.com → Security → App passwords
# (requires 2FA). Your normal account password will NOT work for SMTP.
# SMTP_SECURE defaults to true on port 465 and false (STARTTLS) elsewhere.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Optional, only for the "resend" transport. Note Resend delivers ONLY to your
# own account address until you verify a sender domain via DNS — which is why
# it can't serve an install that has no domain.
RESEND_API_KEY=

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── OAuth: Google ─────────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Discord ────────────────────────────────────────────
# https://discord.com/developers/applications → New Application → OAuth2
# Redirect URI: http://localhost:8080/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Admin / hosting-point sync ────────────────────────────────
# Comma-separated list of user emails allowed to manage /api/settings
# (hosting points list, sync on/off, interval).
#
# The account has to have VERIFIED this address before it counts as an admin:
# registration accepts any email and hands back a session straight away, so
# otherwise whoever registers a listed address first — not whoever owns the
# inbox — becomes the admin. Click the link in the verification mail, or sign
# in with Google/Discord on that address.
ADMIN_EMAILS=

# ── Power controller ─────────────────────────────────────────
# Shared secret the host-side power-controller (see power-controller/) must
# send as X-Power-Secret when polling GET /internal/power/status. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POWER_CONTROLLER_SECRET=

# ── Chromecast ───────────────────────────────────────────────
# Custom CAF receiver app id registered in the Google Cast console. Unset is
# fine: it defaults to the shared receiver deployment (streamio-cast-receiver),
# which learns which install to talk to from each cast. Set it only to point at
# your own deployment of that repo — see docs/features.md "Chromecast".
CAST_RECEIVER_APP_ID=

# ── Versioning / self-update ─────────────────────────────────
# Shared secret the host-side updater (see updater/) must send as
# X-Update-Secret when polling GET /internal/update/status. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPDATE_CONTROLLER_SECRET=

# GitHub repo (owner/name) releases are published to. Used as the default for
# the update check; the admin API (/api/settings/update) overrides it.
UPDATE_REPO=

# Optional GitHub token — only needed for a private repo, or to avoid the
# unauthenticated API rate limit.
UPDATE_GITHUB_TOKEN=

# ── Native client version policy ─────────────────────────────
# Defaults for what GET /api/version reports to the app. These are fallbacks
# only: anything set through PUT /api/settings/client-version wins.
# Newest published app build.
CLIENT_LATEST_VERSION=
# Oldest app build this server still accepts. Only enforced (426 Upgrade
# Required) once "enforce" is turned on via the admin API.
CLIENT_MIN_VERSION=
# Where to send a user whose app is too old.
CLIENT_DOWNLOAD_URL=
