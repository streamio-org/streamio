# Base URL of the Streamio app this controller watches. If Streamio runs in
# Docker on the same host with port 8080 published (see ../docker-compose.yml),
# this is usually http://localhost:8080.
STREAMIO_URL=http://localhost:8080

# Must match POWER_CONTROLLER_SECRET in the main app's .env.
POWER_CONTROLLER_SECRET=57071add9ebd90097e33d51389689c04ee2f85d1deed7d90b5085891038a29b0

# How often to poll the status endpoint, in seconds.
POLL_INTERVAL_SECONDS=30

# Set to "true" to log what would happen without actually powering off —
# useful for testing the polling/auth/idle-detection path safely.
DRY_RUN=true

# ── Optional: login-checker integration ─────────────────────────
# See ../login-checker/README.md. When someone is logged into the host's
# desktop session, idle-triggered auto-shutdown is paused (manual/admin
# shutdown always still goes through). Leave LOGIN_CHECK_TOKEN unset to
# disable this check entirely.
LOGIN_CHECK_URL=http://127.0.0.1:3001
LOGIN_CHECK_TOKEN=
