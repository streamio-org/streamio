# Base URL of the Streamio app this updater watches. If Streamio runs in
# Docker on the same host with port 8080 published (see ../docker-compose.yml),
# this is usually http://localhost:8080.
STREAMIO_URL=http://localhost:8080

# Must match UPDATE_CONTROLLER_SECRET in the main app's .env.
UPDATE_CONTROLLER_SECRET=

# The git checkout that docker-compose.yml lives in — the tree this process
# checks out release tags into and rebuilds. Defaults to the parent directory.
REPO_DIR=/mnt/Film/new-streamio/web

# Remote to fetch release tags from.
GIT_REMOTE=origin

# Compose service to rebuild. Only the app image is rebuilt; db/redis/redirect
# are left running.
COMPOSE_SERVICE=streamio

# How often to poll for a pending update, in seconds. Updates are rare — there
# is no reason to poll this often; the manual "apply" flag lives for 30
# minutes, so anything under that still picks it up.
POLL_INTERVAL_SECONDS=300

# How long to wait for the rebuilt app to report the new version on /health
# before treating the update as failed (and rolling back).
HEALTH_TIMEOUT_SECONDS=300

# Set to "true" to log what would happen without checking anything out or
# rebuilding — useful for testing the polling/auth path safely.
DRY_RUN=true
